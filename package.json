{
  "name": "recent-edits",
  "version": "1.5.0",
  "description": "Shows files modified in the last N days, grouped by day. Marks edits made from outside Obsidian (filesystem writes, sync, plugins) with a configurable indicator.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "recent",
    "files",
    "edits",
    "history",
    "external-edits"
  ],
  "author": "Chris Wagner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cwagner223355/obsidian-recent-edits"
  },
  "bugs": {
    "url": "https://github.com/cwagner223355/obsidian-recent-edits/issues"
  },
  "homepage": "https://github.com/cwagner223355/obsidian-recent-edits",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
